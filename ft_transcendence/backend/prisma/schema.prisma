generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  ONGOING
  FINISHED
  DRAW
  PENDING
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String?
  passwordHash  String
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  
  avatarUrl     String?  // e.g. "uploads/avatars/1-17000000.png"
  
  googleSub     String?  @unique // <-- add this (nullable, unique)
  
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // base32 secret for TOTP
  
  matchesAsP1   Match[]  @relation("MatchPlayer1")
  matchesAsP2   Match[]  @relation("MatchPlayer2")
  wins          Match[]  @relation("MatchWinner")
  
  notifications Notification[]
}

model Match {
  id            Int           @id @default(autoincrement())
  createdAt     DateTime      @default(now())
  status        MatchStatus   @default(PENDING)
  
  // players (REQUIRED for normal 1v1 matches)
  player1Id     Int?
  player2Id     Int?
  player1       User?          @relation("MatchPlayer1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2       User?          @relation("MatchPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  
  // score
  player1Score  Int           @default(0)
  player2Score  Int           @default(0)
  
  // winner (DRAW has null winnerId)
  winnerId      Int?
  winner        User?         @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  
  durationMs    Int?
  
  @@index([player1Id, createdAt])
  @@index([player2Id, createdAt])
  @@index([winnerId])
}

model Notification {
  id              Int                 @id @default(autoincrement())
  message         String
  userId          Int?
  read            Boolean             @default(false)
  createdAt       DateTime            @default(now())
  
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PublicItem {
  id              Int                 @id @default(autoincrement())
  title           String
  content         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}
