export KEY="supersecret_key_change_me"
// Viewing everything in public APIs
curl -s http://localhost:3000/public/items \
  -H "x-api-key: $KEY" | jq

Adding it to the items array
curl -s -X POST http://localhost:3000/public/items \
  -H "x-api-key: $KEY" \
  -H "content-type: application/json" \
  -d '{"title":"first item","content":"hello"}' | jq

To view single item
curl -s http://localhost:3000/public/items/1 \
  -H "x-api-key: $KEY" | jq

Update the item
curl -s -X PUT http://localhost:3000/public/items/1 \
  -H "x-api-key: $KEY" \
  -H "content-type: application/json" \
  -d '{"title":"updated","content":"changed"}' | jq

DELETE
url -i -X DELETE http://localhost:3000/public/items/1 \
  -H "x-api-key: $KEY"

Testing for security
curl -i http://localhost:3000/public/items

Testing using wrong key
curl -i http://localhost:3000/public/items \
  -H "x-api-key: wrong"





