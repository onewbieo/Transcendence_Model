doing search for 31 times(can find is 200, bad credentials is 401, 429 means limit reached)
for i in $(seq 1 31); do curl -o /dev/null -w "search $i => %{http_code}\n" $CURL_OPTS "$BASE_URL/users/search?q=user&token=$USER1_TOKEN"; done

generating matches (201 first one created the match, 409 means rejected as duplicate, 429 means limited reached)
for i in $(seq 1 31); do curl -o /dev/null -w "matches $i => %{http_code}\n" $CURL_OPTS -X POST "$BASE_URL/matches?token=$ADMIN_TOKEN" -H 'Content-Type: application/json' -d '{"player1Id":1,"player2Id":2,"player1Score":5,"player2Score":3,"status":"FINISHED","winnerId":1,"durationMs":120000}'; done

